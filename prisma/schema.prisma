generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  date      String
  category  String
  title     String
  excerpt   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  day       String
  month     String
  title     String
  venue     String
  time      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Student {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Application {
  id              String            @id @default(cuid())
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id])
  programme       String
  branch          String
  entranceExam    String
  entranceScore   String
  boardPercent    String
  address         String
  city            String
  state           String
  pincode         String
  guardianName    String
  guardianPhone   String
  status          ApplicationStatus @default(PENDING)
  adminNote       String?
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model DynamicSection {
  id        String   @id @default(cuid())
  group     String
  slug      String
  title     String
  subtitle  String   @default("")
  content   String   @default("")
  pdfUrl    String   @default("")
  pdfs      Json     @default("[]")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, slug])
}

model Enquiry {
  id          String   @id @default(cuid())
  source      String
  name        String
  email       String
  phone       String?
  course      String?
  message     String
  read        Boolean  @default(false)
  submittedAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  batch     String
  company   String
  quote     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeedbackForm {
  id        String             @id @default(cuid())
  category  FeedbackCategory   @unique
  fields    Json
  active    Boolean            @default(true)
  updatedAt DateTime           @updatedAt
  responses FeedbackResponse[]
}

model FeedbackResponse {
  id          String           @id @default(cuid())
  formId      String
  form        FeedbackForm     @relation(fields: [formId], references: [id])
  category    FeedbackCategory
  data        Json
  submittedAt DateTime         @default(now())
}

enum FeedbackCategory {
  STUDENT
  PARENT
  ALUMNI
  TEACHER_PUBLIC
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}
