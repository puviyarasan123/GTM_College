generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  date      String
  category  String
  title     String
  excerpt   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  day       String
  month     String
  title     String
  venue     String
  time      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Student {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Application {
  id              String            @id @default(cuid())
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id])
  programme       String
  branch          String
  entranceExam    String
  entranceScore   String
  boardPercent    String
  address         String
  city            String
  state           String
  pincode         String
  guardianName    String
  guardianPhone   String
  status          ApplicationStatus @default(PENDING)
  adminNote       String?
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}
